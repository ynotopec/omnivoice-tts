[Unit]
Description=OmniVoice TTS Service (systemd user)
After=network.target

[Service]
Type=simple
ExecStart=/home/ai-agent/work/omnivoice-tts/.venv/bin/uvicorn app.server:app --host 0.0.0.0 --port 8001 --log-level info
WorkingDirectory=/home/ai-agent/work/omnivoice-tts
Environment=PATH=/home/ai-agent/work/omnivoice-tts/.venv/bin:%(ENV_PATH)
Environment=CUDA_VISIBLE_DEVICES=0
EnvironmentFile=/home/ai-agent/work/omnivoice-tts/.env
RestartSec=5
StandardOutput=journal
StandardError=journal
# GPU passthrough
CUDA_VISIBLE_DEVICES=0

[Install]
WantedBy=default.target
