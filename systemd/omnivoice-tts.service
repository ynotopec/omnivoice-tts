[Unit]
Description=OmniVoice TTS Service (systemd user)
After=network.target

[Service]
Type=simple
ExecStart=/home/ai-agent/work/omnivoice-tts/.venv/bin/python /home/ai-agent/work/omnivoice-tts/app/server.py
WorkingDirectory=/home/ai-agent/work/omnivoice-tts
Environment=PATH=/home/ai-agent/work/omnivoice-tts/.venv/bin:%(ENV_PATH)
EnvironmentFile=/home/ai-agent/work/omnivoice-tts/.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# GPU passthrough
CUDA_VISIBLE_DEVICES=0

[Install]
WantedBy=default.target
