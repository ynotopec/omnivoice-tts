# OmniVoice TTS configuration
OMNIVOICE_HOST=0.0.0.0
OMNIVOICE_PORT=8001
MODEL_NAME=k2-fsa/OmniVoice
MODEL_CACHE_DIR=~/.cache/huggingface
VOICES_DIR=~/.omnivoice/voices
CUDA_VISIBLE_DEVICES=0
# API_KEY: If set, all /v1/* endpoints require "Authorization: Bearer <API_KEY>" header
# The $ in shell must be escaped: curl -H 'Authorization: Bearer Antoni...$999' ...
OMNIVOICE_API_KEY=
